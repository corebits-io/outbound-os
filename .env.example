# Copy this file to a new file named ".env" and paste your real keys after each "=".
# IMPORTANT: put the key right after the "=" with nothing else on that line.
# An API key is just a password that lets this system log into another tool automatically.
# Never share .env or commit it anywhere public. Keep real keys out of chats and screenshots.
#
# You do NOT need every key to start. Leave any you don't have blank — the system
# tells you what it can/can't do with the keys present, and never spends without asking.

# === SOURCING (optional) ===
# Pull target companies at scale (e.g., the Y Combinator directory) when free web search isn't enough.
# Without this, sourcing uses free web search + public directories.
# Apify — get a token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# === ENRICHMENT (optional) ===
# Find + verify emails and find phones. Used as a waterfall (BetterContact first), stop at first valid hit.
# BetterContact (best single one to start with): https://bettercontact.rocks
BETTERCONTACT_API_KEY=
# Findymail (fallback finder + email verify): https://app.findymail.com/user/api-tokens
FINDYMAIL_API_KEY=
# Prospeo (fallback finder + mobile numbers): https://prospeo.io
PROSPEO_API_KEY=

# === SEQUENCER (required only to load + send leads — add the one you use) ===
# Instantly: Settings -> Integrations -> API
INSTANTLY_API_KEY=
# Smartlead (alternative): https://app.smartlead.ai -> Settings -> API
SMARTLEAD_API_KEY=

# === Add a tool later (uncomment when you adopt it) ===
# OTHER_PHONE_API_KEY=
# HEYREACH_API_KEY=   # LinkedIn sequencing / intent layer (roadmap)
